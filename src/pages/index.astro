---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import { site, services, areas, generalFaqs } from '../data/site';

const faqs = generalFaqs.slice(0, 5);
---
<Base
  title="Leak Detection in Bargersville, IN | Non-Invasive Leak Location"
  description="Suspect a hidden leak? We locate water leaks under slabs, inside walls, in yards and pools across Bargersville, without tearing things up. Schedule an inspection."
  faqs={faqs}
  preload={{ href: '/images/hero.webp', srcset: '/images/hero-xs.webp 640w, /images/hero-sm.webp 900w, /images/hero.webp 1600w', sizes: '100vw' }}
>
  <Hero />

  <div class="trust">
    <div class="container trust-grid">
      <div><b>Marked</b><span>Exact spot flagged before any repair</span></div>
      <div><b>{site.claims.sameDay ? 'Same day' : 'Local'}</b><span>{site.claims.sameDay ? 'Appointments across ' : 'Team based in '}{site.claims.sameDay ? site.county : site.city}</span></div>
      <div><b>0</b><span>Unnecessary holes dug</span></div>
      <div><b>1 report</b><span>Photos + readings for your insurer</span></div>
    </div>
  </div>

  <section class="section" id="what-is">
    <div class="container intro-grid">
      <div>
        <span class="eyebrow">Water leak detection</span>
        <h2>What is professional leak detection?</h2>
        <p class="intro-lede">Professional leak detection finds a hidden water leak <b>without opening floors, walls or yards to search</b>. A technician confirms the leak with a meter test, isolates which line is leaking, then pinpoints the spot with pressure testing, acoustic listening and thermal imaging. The spot is marked so the repair starts in the right place.</p>
        <p>Detection and repair are separate steps. We find and mark the leak; the repair is usually done by a plumber, through one small opening instead of several.</p>
        <a class="btn btn-ghost" href="/guides/leak-detection-methods/">How leak detection works<Icon name="arrow" /></a>
      </div>
      <div class="signs-card">
        <h3>Signs you may have a hidden leak</h3>
        <ul class="list">
          <li><Icon name="check" /><span>Your water bill jumped with no change in use</span></li>
          <li><Icon name="check" /><span>The water meter moves with everything turned off</span></li>
          <li><Icon name="check" /><span>Warm or damp spots on the floor</span></li>
          <li><Icon name="check" /><span>Stains, bubbling paint or a musty smell</span></li>
          <li><Icon name="check" /><span>Soggy or extra-green patches in the yard</span></li>
          <li><Icon name="check" /><span>The sound of running water when nothing is on</span></li>
        </ul>
        <a class="signs-link" href="/guides/how-to-find-a-water-leak-in-your-house/">How to check for a leak yourself<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section alt" id="services">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2>Every kind of hidden leak, found without tearing things up</h2>
        <p>From slab leaks under your kitchen floor to a pool that won’t hold water, we use the right tool for each kind of leak.</p>
      </div>
      <div class="cards">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <Process />

  <section class="section" id="after">
    <div class="container after-grid">
      <div class="after-card">
        <span class="after-eyebrow">After we find it</span>
        <h2>Detection first, then a small, targeted repair</h2>
        <ol class="after-flow">
          <li><span class="af-ico"><Icon name="pin" /></span><b>Mark</b><span>The exact spot is flagged on your floor, wall or lawn.</span></li>
          <li><span class="af-ico"><Icon name="report" /></span><b>Document</b><span>Photos and readings for your plumber and insurer.</span></li>
          <li><span class="af-ico"><Icon name="check" /></span><b>Repair</b><span>Your plumber opens one small area and fixes the pipe.</span></li>
        </ol>
        <p class="after-note">For slab leaks, the usual repairs are a <b>spot repair</b>, a <b>reroute</b> or a <b>repipe</b>, depending on the pipe’s age and condition.</p>
      </div>
      <div class="why-card">
        <span class="eyebrow">Why it matters</span>
        <h2>Why accurate leak detection matters</h2>
        <ul class="why-list">
          <li><span class="why-ico"><Icon name="shield" /></span><div><b>Less demolition</b><span>One small opening instead of holes in tile, concrete or lawn.</span></div></li>
          <li><span class="why-ico"><Icon name="slab" /></span><div><b>A smaller repair</b><span>Less flooring, drywall and concrete to put back.</span></div></li>
          <li><span class="why-ico"><Icon name="clock" /></span><div><b>A faster fix</b><span>Your plumber starts in the right place.</span></div></li>
          <li><span class="why-ico"><Icon name="report" /></span><div><b>Insurance-ready</b><span>Photos and readings for your claim.</span></div></li>
        </ul>
        <a class="more-link" href="/guides/leak-detection-methods/">How we find leaks without tearing things up<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section tint" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Service area</span>
        <h2>Based in {site.city}, serving all of {site.county}</h2>
        <p>Pick your town to see our service area, or call and ask if you’re nearby.</p>
      </div>
      <div class="chips">
        {areas.map((a, i) => <a class={i === 0 ? 'chip home' : 'chip'} href={`/service-area/#${a.slug}`}><Icon name="pin" />{a.name}, IN</a>)}
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Questions homeowners ask</span>
        <h2>Leak detection FAQ</h2>
      </div>
      <Faq items={faqs} />
      <p style="margin-top:20px"><a class="btn btn-ghost btn-sm" href="/faq/">See all questions<Icon name="arrow" /></a></p>
    </div>
  </section>

  <CtaBand />
</Base>
