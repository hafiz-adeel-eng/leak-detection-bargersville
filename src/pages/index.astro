---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import { plumbing } from '../data/plumbing';
import { site, services, areas, generalFaqs } from '../data/site';
import { locationUrl } from '../data/locations';
import { getCollection } from 'astro:content';
import { guideUrl } from '../data/guides';

const featured = ['why-is-my-water-bill-so-high', 'how-to-find-a-water-leak-in-your-house', 'how-to-find-a-slab-leak', 'leak-detection-vs-plumber', 'is-leak-detection-worth-it', 'how-to-choose-a-leak-detection-company'];
const allGuides = await getCollection('guides');
const homeGuides = featured.map((id) => allGuides.find((g) => g.id === id)).filter(Boolean) as typeof allGuides;

const faqs = generalFaqs.slice(0, 5);
---
<Base
  title="Leak Detection & Repair in Bargersville, IN | Slab Leaks"
  description="Suspect a hidden leak? We locate water leaks under slabs, inside walls, in yards and pools across Bargersville, without tearing things up. Call today."
  faqs={faqs}
  preload={{ href: '/images/hero.webp', srcset: '/images/hero-xs.webp 640w, /images/hero-sm.webp 900w, /images/hero.webp 1600w', sizes: '100vw' }}
>
  <Hero />

  <div class="trust">
    <div class="container trust-grid">
      <div><b>Marked</b><span>Exact spot flagged before any repair</span></div>
      <div><b>{site.claims.sameDay ? 'Same day' : 'Local'}</b><span>{site.claims.sameDay ? 'Appointments across ' : 'Team based in '}{site.claims.sameDay ? site.county : site.city}</span></div>
      <div><b>0</b><span>Unnecessary holes dug</span></div>
      <div><b>1 report</b><span>Photos + readings for your insurer</span></div>
    </div>
  </div>

  <section class="section whatis" id="what-is">
    <div class="container whatis-grid">
      <div class="whatis-copy">
        <span class="eyebrow">Water leak detection</span>
        <h2>What is professional <span>leak detection?</span></h2>
        <div class="whatis-answer">
          <p>Professional leak detection finds a hidden water leak <b>without opening floors, walls or yards to search</b>. The spot is marked so the repair starts in the right place.</p>
        </div>
        <ol class="whatis-steps">
          <li><span class="ws-ico"><Icon name="gauge" /></span><div><b>Confirm</b><span>A meter test proves there’s a leak.</span></div></li>
          <li><span class="ws-ico"><Icon name="pipe" /></span><div><b>Isolate</b><span>We find which line is leaking.</span></div></li>
          <li><span class="ws-ico"><Icon name="wave" /></span><div><b>Pinpoint</b><span>Pressure, acoustic and thermal testing mark the spot.</span></div></li>
        </ol>
        <div class="whatis-note">
          <span class="wn-ico"><Icon name="report" /></span>
          <p><b>One call from finding to fixing.</b> We find and mark the leak, then our plumbing partner makes the repair through one small opening instead of several. Already have a plumber? We hand them the marked spot and report.</p>
        </div>
        <a class="btn btn-primary" href="/guides/leak-detection-methods/">How leak detection works<Icon name="arrow" /></a>
      </div>

      <aside class="signs-panel" aria-labelledby="signs-title">
        <div class="signs-head">
          <span class="sh-ico"><Icon name="drop" /></span>
          <div><span class="sh-kicker">Quick check</span><h3 id="signs-title">Signs you may have a hidden leak</h3></div>
        </div>
        <ul class="signs-rows">
          <li><span class="sr-ico"><Icon name="report" /></span>Your water bill jumped with no change in use</li>
          <li><span class="sr-ico"><Icon name="gauge" /></span>The water meter moves with everything turned off</li>
          <li><span class="sr-ico"><Icon name="thermal" /></span>Warm or damp spots on the floor</li>
          <li><span class="sr-ico"><Icon name="shower" /></span>Stains, bubbling paint or a musty smell</li>
          <li><span class="sr-ico"><Icon name="sprinkler" /></span>Soggy or extra-green patches in the yard</li>
          <li><span class="sr-ico"><Icon name="wave" /></span>The sound of running water when nothing is on</li>
        </ul>
        <div class="signs-foot">
          <p>Two or more of these? It’s time to check.</p>
          <a class="signs-btn" href="/guides/how-to-find-a-water-leak-in-your-house/">Check for a leak yourself<Icon name="arrow" /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section alt" id="services">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2>Every kind of hidden leak, found without tearing things up</h2>
        <p>From slab leaks under your kitchen floor to a pool that won’t hold water, we use the right tool for each kind of leak.</p>
      </div>
      <div class="cards">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section" id="plumbing">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Plumbing repair</span>
        <h2>Find it, then fix it: plumbing repair too</h2>
        <p>Water heaters, drains, sewer lines and burst or frozen pipes, with hidden leaks pinpointed before anything is opened. <a class="more-link" href="/plumbing/">All plumbing services<Icon name="arrow" /></a></p>
      </div>
      <div class="cards">{plumbing.slice(0, 3).map((p) => <ServiceCard service={p} base="/plumbing/" />)}</div>
    </div>
  </section>

  <Process />

  <section class="section" id="after">
    <div class="container after-grid">
      <div class="after-card">
        <span class="after-eyebrow">After we find it</span>
        <h2>Detection first, then a small, targeted repair</h2>
        <ol class="after-flow">
          <li><span class="af-ico"><Icon name="pin" /></span><b>Mark</b><span>The exact spot is flagged on your floor, wall or lawn.</span></li>
          <li><span class="af-ico"><Icon name="report" /></span><b>Document</b><span>Photos and readings for your plumber and insurer.</span></li>
          <li><span class="af-ico"><Icon name="check" /></span><b>Repair</b><span>Our plumbing partner, or your own plumber, opens one small area and fixes the pipe.</span></li>
        </ol>
        <p class="after-note">For slab leaks, the usual repairs are a <b>spot repair</b>, a <b>reroute</b> or a <b>repipe</b>, depending on the pipe’s age and condition.</p>
      </div>
      <div class="why-card">
        <span class="eyebrow">Why it matters</span>
        <h2>Why accurate leak detection matters</h2>
        <ul class="why-list">
          <li><span class="why-ico"><Icon name="shield" /></span><div><b>Less demolition</b><span>One small opening instead of holes in tile, concrete or lawn.</span></div></li>
          <li><span class="why-ico"><Icon name="slab" /></span><div><b>A smaller repair</b><span>Less flooring, drywall and concrete to put back.</span></div></li>
          <li><span class="why-ico"><Icon name="clock" /></span><div><b>A faster fix</b><span>The repair starts in the right place, with no second company to schedule.</span></div></li>
          <li><span class="why-ico"><Icon name="report" /></span><div><b>Insurance-ready</b><span>Photos and readings for your claim.</span></div></li>
        </ul>
        <a class="more-link" href="/guides/leak-detection-methods/">How we find leaks without tearing things up<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" id="guides">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Homeowner guides</span>
        <h2>Check for a leak yourself, then decide who to call</h2>
        <p>Plain answers from our leak detection work around {site.county}.</p>
      </div>
      <div class="guide-links">
        <ul>{homeGuides.map((g) => <li><a href={guideUrl(g)}><Icon name="report" />{g.data.h1}</a></li>)}</ul>
      </div>
      <p style="margin-top:20px"><a class="btn btn-ghost btn-sm" href="/guides/">All leak detection guides<Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section tint" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Service area</span>
        <h2>Based in {site.city}, serving {site.county} and nearby towns</h2>
        <p>Pick your town for local leak detection details, or call and ask if you’re nearby.</p>
      </div>
      <div class="chips">
        {areas.map((a, i) => <a class={i === 0 ? 'chip home' : 'chip'} href={locationUrl(a.slug)}><Icon name="pin" />{a.name}, IN</a>)}
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Questions homeowners ask</span>
        <h2>Leak detection FAQ</h2>
      </div>
      <Faq items={faqs} />
      <p style="margin-top:20px"><a class="btn btn-ghost btn-sm" href="/faq/">See all questions<Icon name="arrow" /></a></p>
    </div>
  </section>

  <CtaBand />
</Base>
