---
import ServicePage from '../../components/ServicePage.astro';
import { services, type Service } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props as { service: Service };
---
<ServicePage service={service} pool={services} kind="leak" />
