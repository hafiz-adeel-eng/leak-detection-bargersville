---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, services, areas } from '../data/site';
---
<Base
  title={`Call for Leak Detection | ${site.name}`}
  description={`Call ${site.phone} for leak detection in ${site.city} and ${site.county}, IN. Slab, underground, hidden, pool, thermal and irrigation leaks.`}
  breadcrumbs={[{ name: 'Contact', url: '/contact/' }]}
>
  <section class="page-hero dark">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Contact</span></nav>
      <h1>Call to schedule leak detection</h1>
      <p class="answer">The fastest way to reach us is a phone call. Tell us what you’re noticing and where you are, and we’ll set up a time to find the leak.</p>
      <div class="ctas">
        <a class="btn btn-primary call-big" href={`tel:${site.phoneHref}`}><Icon name="phone" />Call {site.phone}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-cards">
      <div class="info-card">
        <span class="ico"><Icon name="phone" /></span>
        <h2>When you call, it helps to know</h2>
        <ul class="list">
          <li><Icon name="check" /><span>What you’re noticing: a high bill, a warm floor, a wet spot, a stain, or a pool that keeps dropping</span></li>
          <li><Icon name="check" /><span>Whether your water meter moves with everything turned off</span></li>
          <li><Icon name="check" /><span>Your town and the type of home (slab, basement or crawl space)</span></li>
          <li><Icon name="check" /><span>If water is actively spreading, turn off the main valve first</span></li>
        </ul>
      </div>
      <div class="info-card">
        <span class="ico"><Icon name="pin" /></span>
        <h2>Where we work</h2>
        <p>Based in {site.city}, serving {areas.map((a) => a.name).join(', ')}.</p>
        <a class="more-link" href="/service-area/">See our service area<Icon name="arrow" /></a>
        <h2 style="margin-top:8px">What we find</h2>
        <ul class="list">
          {services.map((s) => <li><Icon name={s.icon} /><span><a href={`/services/${s.slug}/`}>{s.name}</a></span></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
