---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Page not found | ${site.name}`} description="This page could not be found." noindex>
  <section class="page-hero dark" style="border:0">
    <div class="container">
      <h1>This page sprang a leak.</h1>
      <p class="answer">We couldn’t find that page. Head back home or call {site.phone}.</p>
      <div class="ctas"><a class="btn btn-primary" href="/">Back to home</a></div>
    </div>
  </section>
</Base>
