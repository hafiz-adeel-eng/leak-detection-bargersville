---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, services, generalFaqs } from '../data/site';

const seen = new Set<string>();
const unique = (items: typeof generalFaqs) => items.filter((f) => {
  if (seen.has(f.q)) return false;
  seen.add(f.q);
  return true;
});
// One H2 per topic, so the page has a real outline instead of one long list.
const groups = [
  { id: 'general', h2: 'General leak detection questions', items: unique(generalFaqs) },
  ...services.map((s) => ({ id: s.slug, h2: `${s.name}: questions`, url: `/services/${s.slug}/`, name: s.name, items: unique(s.faqs) })),
].filter((g) => g.items.length > 0);
const all = groups.flatMap((g) => g.items);
---
<Base
  title="Leak Detection FAQ: Signs, Process & Insurance"
  description="Answers to common leak detection questions from Bargersville homeowners: signs of a slab leak, how detection works, insurance, pool leaks and more."
  faqs={all}
  breadcrumbs={[{ name: 'FAQ', url: '/faq/' }]}
>
  <section class="page-hero dark">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>FAQ</span></nav>
      <h1>Leak detection questions, answered</h1>
      <p class="answer">Straight answers about hidden water leaks, how we find them, and what to do next. Don’t see your question? Call {site.phone}.</p>
    </div>
  </section>
  <section class="section">
    <div class="container faq-groups">
      {groups.map((g) => (
        <div class="faq-group" id={g.id}>
          <h2>{g.h2}</h2>
          {'url' in g && g.url && <p class="faq-more">More on <a href={g.url}>{g.name.toLowerCase()}</a>.</p>}
          <Faq items={g.items} openFirst={false} />
        </div>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
