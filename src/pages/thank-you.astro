---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Request received | ${site.name}`} description="Thanks for contacting us." noindex>
  <section class="page-hero" style="border:0">
    <div class="container">
      <h1>Thanks, we got your request.</h1>
      <p class="answer">We’ll contact you shortly to confirm a time. If water is actively spreading, call {site.phone} now.</p>
      <div class="ctas"><a class="btn btn-primary" href="/">Back to home</a></div>
    </div>
  </section>
</Base>
