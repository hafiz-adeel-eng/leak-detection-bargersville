---
import Icon from './Icon.astro';
import { site } from '../data/site';

const features = [
  { icon: 'drop', label: 'Water Leak Detection', href: '/services/water-line-leak-detection/' },
  { icon: 'slab', label: 'Slab Leak Detection', href: '/services/slab-leak-detection/' },
  { icon: 'home', label: 'Hidden Leak Solutions', href: '/services/thermal-imaging/' },
  { icon: 'shield', label: 'Residential & Commercial', href: '/contact/' },
];
---
<section class="hx">
  <div class="hx-media">
    <img
      src="/images/hero.webp"
      srcset="/images/hero-sm.webp 900w, /images/hero.webp 1600w"
      sizes="100vw"
      alt="Leak detection technician wearing headphones uses an acoustic ground microphone to find a hidden water line leak outside a Bargersville home"
      width="1600" height="900" fetchpriority="high" decoding="async"
    />
  </div>

  <div class="hx-trust" aria-label="Why homeowners choose us">
    <span><Icon name="shield" /><b>Trusted</b> Local Experts</span>
    <span><Icon name="clock" /><b>Fast &amp;</b> Reliable Service</span>
    <span><Icon name="pin" /><b>{site.city}</b> &amp; Surrounding Areas</span>
  </div>

  <div class="hx-inner">
    <div class="hx-copy">
      <p class="hx-eyebrow">Find it <i>•</i> Fix it <i>•</i> Protect your home</p>
      <h1>
        <span class="w">Professional</span>
        <span class="g">Leak Detection</span>
        <span class="w sm">in {site.city}</span>
      </h1>
      <p class="hx-lede">Accurate leak detection. Less damage. A healthier home.</p>

      <ul class="hx-features">
        {features.map((f) => (
          <li><a href={f.href}><span class="ring"><Icon name={f.icon} /></span>{f.label}</a></li>
        ))}
      </ul>

      <div class="hx-ctas">
        <a class="btn-gold" href="/contact/">Get a Free Estimate<Icon name="arrow" /></a>
        <a class="hx-call" href={`tel:${site.phoneHref}`}><Icon name="phone" />{site.phone}</a>
      </div>
    </div>
  </div>
</section>
