---
import type { Faq } from '../data/site';
interface Props { items: Faq[]; openFirst?: boolean }
const { items, openFirst = true } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={openFirst && i === 0}>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
