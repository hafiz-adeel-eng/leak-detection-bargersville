---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { site, services, areas, hoursText, type Faq } from '../data/site';
import { image } from '../data/images';
import { locations, locationUrl } from '../data/locations';

interface Props {
  title: string;
  description: string;
  faqs?: Faq[];
  breadcrumbs?: { name: string; url: string }[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  preload?: { href: string; srcset?: string; sizes?: string };
  ogType?: 'website' | 'article';
  ogImage?: string; // site-relative image path; defaults to the site OG image
  article?: { published: string; modified: string };
}

const { title, description, faqs = [], breadcrumbs = [], schema = [], noindex = false, preload, ogType = 'website', ogImage: pageOg, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogFile = image('og-image') ?? image('hero');
const siteOg = ogFile ? new URL(ogFile, site.url).href : undefined;
const ogImage = pageOg ? new URL(pageOg, site.url).href : siteOg;
const year = new Date().getFullYear();

const business = {
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: `${site.url}/`,
  logo: `${site.url}/images/logo.png`,
  telephone: site.phoneHref,
  description: `Non-invasive water leak detection in ${site.city}, Indiana and across ${site.county}: slab, underground, hidden, pool, thermal imaging and irrigation leaks, pinpointed and marked for repair.`,
  ...(siteOg ? { image: siteOg } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    postalCode: site.postalCode,
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 39.5209, longitude: -86.1678 },
  areaServed: areas.map((a) => {
    const loc = locations.find((l) => l.slug === a.slug);
    return { '@type': 'City', name: `${a.name}, IN`, url: new URL(locationUrl(a.slug), site.url).href, ...(loc ? { sameAs: loc.wiki } : {}) };
  }),
  ...(site.claims.emergency247
    ? { openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '00:00', closes: '23:59' } }
    : {}),
  knowsAbout: services.map((s) => s.name),
  ...(site.gbpUrl ? { sameAs: [site.gbpUrl] } : {}),
};

const graph: Record<string, unknown>[] = [
  business,
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, publisher: { '@id': `${site.url}/#business` } },
  ...schema,
];
if (faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', url: '/' }, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.url, site.url).href,
    })),
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0B2240" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="geo.region" content="US-IN" />
    <meta name="geo.placename" content={site.city} />

{preload && <link rel="preload" as="image" href={preload.href} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header dark">
      <div class="container nav">
        <Logo />
        <ul class="nav-links" id="nav-links">
          <li><a href="/#services">Services</a></li>
          <li><a href="/#how-it-works">How it works</a></li>
          <li><a href="/service-area/">Service area</a></li>
          <li><a href="/guides/">Guides</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
        <a class="btn btn-primary btn-sm btn-call-top" style="white-space:nowrap" href={`tel:${site.phoneHref}`}><Icon name="phone" />{site.phone}</a>
        <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links"><Icon name="menu" /></button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer dark">
      <div class="container">
        <div class="footer-grid">
          <div>
            <Logo />
            <p>Non-invasive leak detection for homes in {site.city} and across {site.county}. We find the leak so the repair starts in the right place.</p>
          </div>
          <div>
            <h2 class="footer-h">Services</h2>
            <ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}</ul>
          </div>
          <div>
            <h2 class="footer-h">Service areas</h2>
            <ul>{areas.map((a) => <li><a href={locationUrl(a.slug)}>Leak detection {a.name}</a></li>)}</ul>
          </div>
          <div>
            <h2 class="footer-h">Contact</h2>
            <ul>
              <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
              <li><a href="/guides/">Leak detection guides</a></li>
              <li><a href="/leak-detection-cost/">Leak detection cost</a></li>
              <li><a href="/faq/">Leak detection FAQ</a></li>
              {site.gbpReviewUrl && <li><a href={site.gbpReviewUrl} rel="noopener">Leave us a Google review</a></li>}
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} {site.name}. {site.city}, Indiana.</span>
          <span>{hoursText}</span>
        </div>
      </div>
    </footer>

    <div class="callbar dark">
      <a class="btn btn-primary btn-sm" href={`tel:${site.phoneHref}`}><Icon name="phone" />Call {site.phone}</a>
    </div>

    <script>
      const btn = document.querySelector('.menu-btn');
      const links = document.getElementById('nav-links');
      btn?.addEventListener('click', () => {
        const open = links?.classList.toggle('open') ?? false;
        btn.setAttribute('aria-expanded', String(open));
      });
      links?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) {
          links.classList.remove('open');
          btn?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
