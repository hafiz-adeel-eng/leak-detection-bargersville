// Cloudflare Workers Builds config for this static Astro site.
// `build.command` makes both `wrangler deploy` (production, main) and
// `wrangler preview` (other branches) build the site first, then upload dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leak-detection-bargersville",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "previews": {}
}
